# Copy to .env.local (git-ignored) and fill in what you need.
# The server reads these at boot; the web package reads VITE_* at build/dev time.

JWT_SECRET=change-me-in-production
AUTH_DISABLED=true
AUDIT_LOG_PATH=./audit.log
ALLOW_DESTRUCTIVE_TOOLS=false
VITE_DEV_TOKEN=

# Demo mode: set VITE_DEMO_MODE=true in packages/web/.env.local (git-ignored)
# to run the cockpit fully offline — no socket, no REST calls, canned agent
# output. Ideal for recordings and pitch demos.
VITE_DEMO_MODE=false

# Phase 6 login + LLM planner
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=change-me
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-7-sonnet-latest

# Phase 7 remote agents: the agent socket connects with auth { token: AGENT_TOKEN }.
# Set AGENT_TOKEN on BOTH the central server and every agent process.
AGENT_TOKEN=
AGENT_SERVER_URL=http://localhost:8787
