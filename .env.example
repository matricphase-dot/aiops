# Copy to .env.local (git-ignored) and fill in what you need.
# The server reads these at boot; the web package reads VITE_* at build/dev time.

JWT_SECRET=change-me-in-production
AUTH_DISABLED=true
AUDIT_LOG_PATH=./audit.log
ALLOW_DESTRUCTIVE_TOOLS=false
VITE_DEV_TOKEN=

# Phase 6 login + LLM planner
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=change-me
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-7-sonnet-latest
