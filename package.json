{
  "name": "aiops-cockpit",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start": "concurrently \"pnpm --filter @aiops/server exec tsx src/index.ts\" \"pnpm --filter @aiops/web dev\"",
    "dev": "pnpm --filter @aiops/web dev",
    "dev:server": "pnpm --filter @aiops/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.7.0"
  }
}